# Where Grainflow publishes its lake. A local folder works too.
SILO_LAKE_URL=https://grainflow-mauve.vercel.app/data/lake
SILO_MAX_ROWS=500
SILO_QUERY_TIMEOUT_S=10
# Public hostname(s) when deployed, comma separated.
SILO_ALLOWED_HOSTS=

# The analyst (silo ask). Never commit a real key.
ANTHROPIC_API_KEY=
SILO_MODEL=claude-haiku-5-5
SILO_DAILY_BUDGET_USD=0.50

# The public page (silo serve --http).
SILO_ASKS_PER_HOUR=6
SILO_PORTFOLIO_URL=
